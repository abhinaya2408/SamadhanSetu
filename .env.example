# ---------------------------------------------------------------------------
# SamadhanSetu — environment configuration (copy to .env and edit)
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=SamadhanSetu
APP_ENV=development
APP_DEBUG=true
# Base URL used when generating absolute links in notifications
APP_BASE_URL=http://127.0.0.1:8000

# Absolute or relative path to the SQLite database file.
# Leave blank to use the default: <project>/instance/samadhansetu.db
DATABASE_URL=

# --- Authentication / security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_HOURS=72
# Session cookie name and flags
SESSION_COOKIE_NAME=smds_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Maximum size of a single citizen evidence photo (bytes) — 5 MB default.
# Applied server-side; the browser check is only a convenience.
# Allowed content types are JPEG, PNG and WebP, decided by magic bytes.
MAX_UPLOAD_BYTES=5242880

# Seed demonstration data on first start when the database is empty
SEED_ON_STARTUP=true

# --- Groq (primary LLM provider, optional) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Pick a currently supported chat-completions model for your account, e.g.
# llama-3.3-70b-versatile — see https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# true = use Groq when a key is present, false = always use local rules
GROQ_ENABLED=true
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RETRIES=2

# --- Screening / matching weights (deterministic fallback algorithm) ---
# Must sum to 1.0 — see DESIGN.md / README.md "Match scoring"
MATCH_WEIGHT_SKILL=0.40
MATCH_WEIGHT_EXPERIENCE=0.20
MATCH_WEIGHT_INTEREST=0.15
MATCH_WEIGHT_AVAILABILITY=0.15
MATCH_WEIGHT_DIVERSITY=0.10
